doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title OTP Verification

  body(
    style="font-family: Arial, sans-serif; background:#f5f5f5; padding:20px; margin:0;"
  )
    div(
      style="max-width:500px; margin:auto; background:white; padding:30px; border-radius:10px;"
    )

      h2(
        style="text-align:center; color:#333;"
      ) Email Verification

      p Hello #{name},

      p(
        style="color:#555;"
      )
        | We received a request to verify your email address.
        | Please use the OTP below to continue.

      div(
        style="text-align:center; margin:30px 0;"
      )
        h1(
          style="letter-spacing:8px; color:#222; font-size:32px;"
        ) #{otp}

      p(
        style="color:#555;"
      )
        | This OTP will expire in 
        strong #{expireTime} minutes.

      p(
        style="color:#777; font-size:14px;"
      )
        | If you did not request this verification code, please ignore this email.

      hr(
        style="border:none; border-top:1px solid #eee; margin:30px 0;"
      )

      p(
        style="font-size:12px; color:#999; text-align:center;"
      )
        | © #{year} #{appName}. All rights reserved.